// Signing and identifiers. Defaults build for the Simulator. To run on a device, create
// Config/Local.xcconfig (git-ignored) with your own values, e.g.
//   DEVELOPMENT_TEAM = ABCDE12345
//   BUNDLE_ID_PREFIX = com.yourname
// The app is <prefix>.radarglance, the widget <prefix>.radarglance.widget, and the shared
// App Group group.<prefix>.radarglance.
BUNDLE_ID_PREFIX = com.example
DEVELOPMENT_TEAM =

#include? "Local.xcconfig"
